# Copia este archivo como .env y ajusta los valores.

PORT=3000
# Si lo pones, la API pide este token (útil si despliegas en internet).
APP_TOKEN=

# Revisión automática (formato cron). Por defecto cada 6 horas.
CHECK_CRON=0 */6 * * *

# Moneda
USD_COP=4000

# Qué cuenta como "oferta confiable" en otra tienda
MIN_RATING=4.0
MIN_REVIEWS=20

# Qué cuenta como "el mismo producto"
MIN_SIMILARITY=0.45
# Un resultado que cueste menos de este % del original se descarta (casi seguro es un accesorio u otro producto)
MIN_PRICE_RATIO=0.4
# Cuántas publicaciones del mismo producto mostrar por tienda
OFFERS_PER_STORE=5

# Alertas
# Sin precio objetivo: avisar cuando baje al menos este % frente al precio de referencia
DROP_PCT=3
# Con precio objetivo: no repetir la alerta salvo que baje al menos este % frente a la última alerta
REALERT_PCT=2
# Correo por defecto si el producto no tiene uno
ALERT_EMAIL_TO=

# SMTP (Gmail: smtp.gmail.com, 465, y una "contraseña de aplicación")
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Tiendas
AMAZON_DOMAIN=www.amazon.com
ML_DOMAIN=mercadolibre.com.co
ML_LISTING_DOMAIN=listado.mercadolibre.com.co
ML_CURRENCY=COP
ML_SITE=MCO

# API oficial de Mercado Libre (gratis). Crea una app en https://developers.mercadolibre.com.co
# y copia aquí sus credenciales. ML_REDIRECT_URI debe ser EXACTAMENTE la que registraste en la app.
# Mercado Libre exige https: puedes registrar https://localhost:3000/api/ml/callback o cualquier
# página https tuya; si el navegador no logra abrirla, copia la URL a la que te mandó y pégala en la app.
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# Navegador. Pon false para ver Chromium abrirse (útil para captchas y depurar).
HEADLESS=true
